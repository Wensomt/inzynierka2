# Opcjonalne źródło obrazu symulatora dla instalatora Linux.
# Nie wpisuj obu wariantów jednocześnie. Wartości nie wymagają cudzysłowów.

# Wariant offline: plik jest przenoszony razem z projektem.
# Domyślna lokalizacja resources/wcnc_tap.tar jest wykrywana automatycznie,
# więc poniższa linia jest potrzebna tylko dla innej ścieżki.
# ORAN_LAB_IMAGE_ARCHIVE=resources/wcnc_tap.tar

# Wariant online: pełna referencja z niezmiennym digestem.
# Przy prywatnym rejestrze najpierw wykonaj docker login <host-rejestru>
# jako ten sam użytkownik, który uruchomi install_linux.sh.
# ORAN_LAB_IMAGE_REF=registry.example.org/oran/wcnc_tap@sha256:UZUPELNIJ_SUMĘ

# Gdy nie podano archiwum ani refu, a katalog .simulator-src zawiera oba
# lokalne źródła i ns3_docker/Dockerfile, instalator zbuduje obraz automatycznie.
# Jeżeli snapshot ma pusty moduł Git src/nr, instalator pobierze dokładnie
# wersję zapisaną w tym snapshotcie przed buildem (wymaga Internetu i git).
# Ustaw 0, aby wyłączyć ten wariant.
# ORAN_LAB_BUILD_LOCAL_SOURCES=0

# Opcjonalna kontrola sumy dla archiwum TAR. Gdy istnieje plik
# resources/wcnc_tap.tar.sha256, instalator użyje go automatycznie.
# ORAN_LAB_IMAGE_SHA256=UZUPELNIJ_SUMĘ_SHA256
